{
  "rules": {
    "realtime": {
      "access": {
        "$canvasId": {
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": false
          }
        }
      },
      "canvases": {
        "$canvasId": {
          ".read": false,
          ".write": false,

          "meta": {
            ".read": "auth != null && (root.child('realtime/access/' + $canvasId + '/' + auth.uid + '/permission').val() === 'view' || root.child('realtime/access/' + $canvasId + '/' + auth.uid + '/permission').val() === 'edit')",
            ".write": false
          },

          "elements": {
            ".read": "auth != null && (root.child('realtime/access/' + $canvasId + '/' + auth.uid + '/permission').val() === 'view' || root.child('realtime/access/' + $canvasId + '/' + auth.uid + '/permission').val() === 'edit')",

            "$elementId": {
              ".write": "auth != null && root.child('realtime/access/' + $canvasId + '/' + auth.uid + '/permission').val() === 'edit' && newData.exists() && newData.child('id').val() === $elementId",
              ".validate": "newData.hasChild('id') && newData.child('id').isString()"
            }
          },

          "files": {
            ".read": false,
            ".write": false
          },

          "$other": {
            ".read": false,
            ".write": false
          }
        }
      },

      "$other": {
        ".read": false,
        ".write": false
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}